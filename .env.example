# Copy to .env and fill in. Every secret can also be read from a file: append _FILE to the name,
# e.g. HME_API_TOKEN_FILE=/run/secrets/hme_api_token

# --- Required -------------------------------------------------------------------------------------------
# API key you enter in Bitwarden. At least 32 characters: openssl rand -hex 32
HME_API_TOKEN=

# Public HTTPS address of this service (shown in Bitwarden error messages and notifications)
HME_PUBLIC_URL=https://hme.example.com

# --- Admin UI -------------------------------------------------------------------------------------------
# password: built-in login with HME_ADMIN_PASSWORD (default)
# proxy:    no built-in login; your reverse proxy (Authelia, Authentik, ...) must protect everything except /api/
HME_ADMIN_AUTH=password
# At least 12 characters, different from HME_API_TOKEN
HME_ADMIN_PASSWORD=

# --- Reverse proxy --------------------------------------------------------------------------------------
# Addresses/networks allowed to set X-Forwarded-For/-Proto (comma-separated, CIDR allowed).
# With the example compose file the proxy reaches the container from the Docker network.
HME_TRUSTED_PROXIES=172.16.0.0/12
# Set to false only for plain-HTTP testing on localhost
HME_COOKIE_SECURE=true

# --- Notifications when the iCloud session expires (optional) -------------------------------------------
HME_NTFY_URL=
HME_NTFY_TOPIC=
HME_NTFY_TOKEN=
# Generic webhook: POST {"title": ..., "message": ..., "url": ...}
HME_WEBHOOK_URL=

# --- Tuning (optional) ----------------------------------------------------------------------------------
# Own limit on new addresses per hour, protects your Apple account if the API key leaks
HME_MAX_ALIASES_PER_HOUR=10
# How often the iCloud session is refreshed, in seconds (minimum 300)
HME_KEEPALIVE_INTERVAL=21600
HME_LOG_LEVEL=INFO
# Access log contains the website of each created address; off by default
HME_ACCESS_LOG=false
